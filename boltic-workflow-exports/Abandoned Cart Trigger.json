        "type": "emailActivity",
        "properties": {
          "cc": [],
          "to": [
            "shreekar.aiml@gmail.com"
          ],
          "bcc": [],
          "from": "craftkart_hacktimus_agent@mail.boltic.app",
          "subject": "Webhook Trigger Log",
          "attachments": [],
          "retry_config": {
            "initial_interval": 1000,
            "maximum_attempts": 1,
            "maximum_interval": 100000,
            "backoff_coefficient": 2
          },
          "email_auth_id": "_BOLTIC_INTEGRATION_BOLTIC_EMAIL",
          "email_template": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Webhook Log</title>\n<style>\n  body { font-family: monospace; font-size: 14px; }\n  .section { margin-bottom: 20px; }\n  .key { font-weight: bold; }\n  pre { white-space: pre-wrap; }\n</style>\n</head>\n<body>\n\n<div class=\"section\">\n  <div class=\"key\">Application ID:</div>\n  <div>{{ payload.application_id }}</div>\n\n  <div class=\"key\">Company ID:</div>\n  <div>{{ payload.company_id }}</div>\n\n  <div class=\"key\">Contains:</div>\n  <ul>\n    {% for item in payload.contains %}\n      <li>{{ item }}</li>\n    {% endfor %}\n  </ul>\n</div>\n\n<div class=\"section\">\n  <div class=\"key\">Event:</div>\n  <pre>\nCategory: {{ payload.event.category }}\nCreated Timestamp: {{ payload.event.created_timestamp }}\nID: {{ payload.event.id }}\nName: {{ payload.event.name }}\nType: {{ payload.event.type }}\nVersion: {{ payload.event.version }}\nTrace IDs:\n{% for t in payload.event.trace_id %}\n  - {{ t }}\n{% endfor %}\n  </pre>\n</div>\n\n<div class=\"section\">\n  <div class=\"key\">Cart:</div>\n  <pre>\nID: {{ payload.payload.cart.id }}\nValid: {{ payload.payload.cart.is_valid }}\nSuccess: {{ payload.payload.cart.success }}\nComment: {{ payload.payload.cart.comment }}\nMessage: {{ payload.payload.cart.message }}\nCurrency Code: {{ payload.payload.cart.currency.code }}\nCurrency Symbol: {{ payload.payload.cart.currency.symbol }}\nLast Modified: {{ payload.payload.cart.last_modified }}\nGSTIN: {{ payload.payload.cart.gstin }}\n  </pre>\n</div>\n\n<div class=\"section\">\n  <div class=\"key\">Breakup Values:</div>\n\n  <div class=\"key\">Coupon:</div>\n  <pre>\nCode: {{ payload.payload.cart.breakup_values.coupon.code }}\nApplied: {{ payload.payload.cart.breakup_values.coupon.is_applied }}\nMessage: {{ payload.payload.cart.breakup_values.coupon.message }}\nType: {{ payload.payload.cart.breakup_values.coupon.type }}\nUID: {{ payload.payload.cart.breakup_values.coupon.uid }}\nValue: {{ payload.payload.cart.breakup_values.coupon.value }}\n  </pre>\n\n  <div class=\"key\">Loyalty Points:</div>\n  <pre>\nApplicable: {{ payload.payload.cart.breakup_values.loyalty_points.applicable }}\nDescription: {{ payload.payload.cart.breakup_values.loyalty_points.description }}\nApplied: {{ payload.payload.cart.breakup_values.loyalty_points.is_applied }}\nTotal: {{ payload.payload.cart.breakup_values.loyalty_points.total }}\n  </pre>\n\n  <div class=\"key\">Raw:</div>\n  <pre>\nCOD Charge: {{ payload.payload.cart.breakup_values.raw.cod_charge }}\nConvenience Fee: {{ payload.payload.cart.breakup_values.raw.convenience_fee }}\nCoupon: {{ payload.payload.cart.breakup_values.raw.coupon }}\nDelivery Charge: {{ payload.payload.cart.breakup_values.raw.delivery_charge }}\nDiscount: {{ payload.payload.cart.breakup_values.raw.discount }}\nFynd Cash: {{ payload.payload.cart.breakup_values.raw.fynd_cash }}\nGST Charges: {{ payload.payload.cart.breakup_values.raw.gst_charges }}\nMOP Total: {{ payload.payload.cart.breakup_values.raw.mop_total }}\nMRP Total: {{ payload.payload.cart.breakup_values.raw.mrp_total }}\nSubtotal: {{ payload.payload.cart.breakup_values.raw.subtotal }}\nTotal: {{ payload.payload.cart.breakup_values.raw.total }}\nTotal Charge: {{ payload.payload.cart.breakup_values.raw.total_charge }}\nVOG: {{ payload.payload.cart.breakup_values.raw.vog }}\nYou Saved: {{ payload.payload.cart.breakup_values.raw.you_saved }}\n  </pre>\n</div>\n\n<div class=\"section\">\n  <div class=\"key\">Items:</div>\n  {% if payload.payload.cart.items.length == 0 %}\n    <div>No items</div>\n  {% else %}\n    <ul>\n      {% for item in payload.payload.cart.items %}\n        <li><pre>{{ item }}</pre></li>\n      {% endfor %}\n    </ul>\n  {% endif %}\n</div>\n\n</body>\n</html>\n",
          "maximum_timeout": 60000,
