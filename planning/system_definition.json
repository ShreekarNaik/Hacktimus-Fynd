  "dataFlows": [
    {
      "id": "exit_intent_flow",
      "name": "Exit Intent → Game Flow",
      "steps": [
        { "from": "fynd_storefront", "to": "popup_script", "data": "User exit intent detected" },
        { "from": "popup_script", "to": "frontend_app", "data": "IFrame with context (userId, cartId, mode=popup)", "mechanism": "URL params" },
        { "from": "frontend_app", "to": "backend_api", "data": "POST /games/start", "mechanism": "REST" },
        { "from": "frontend_app", "to": "backend_api", "data": "POST /games/submit (score)", "mechanism": "REST" },
        { "from": "backend_api", "to": "boltic_tables", "data": "INSERT leaderboard, rewards", "mechanism": "Boltic SDK" },
        { "from": "frontend_app", "to": "popup_script", "data": "postMessage: reward data", "mechanism": "postMessage" },
        { "from": "popup_script", "to": "fynd_storefront", "data": "Optional: auto-apply coupon", "mechanism": "Fynd SDK" }
      ]
    },
    {
      "id": "cart_abandonment_flow",
      "name": "Cart Abandonment → SMS Recovery",
      "steps": [
        { "from": "fynd_platform", "to": "boltic_workflows", "data": "cart.update webhook", "mechanism": "HTTP" },
        { "from": "boltic_workflows", "action": "Wait 100 minutes" },
        { "from": "boltic_workflows", "to": "fynd_platform", "data": "Re-fetch cart state", "mechanism": "Fynd SDK" },
        { "from": "boltic_workflows", "to": "backend_api", "data": "POST /abandoned_cart?user_id=X", "mechanism": "HTTP" },
        { "from": "backend_api", "returns": "{ url: game_link }" },
        { "from": "boltic_workflows", "to": "user", "data": "SMS with game link", "mechanism": "Boltic SMS" },
        { "from": "boltic_workflows", "to": "boltic_tables", "data": "INSERT cart_abandonments", "mechanism": "SQL" }
      ]
    },
    {
      "id": "reward_redemption_flow",
      "name": "Reward → Cart Redemption",
      "steps": [
        { "from": "frontend_app", "to": "boltic_workflows", "data": "GET /get_redeem_link?coupon=X&cart_id=Y", "mechanism": "HTTP" },
        { "from": "boltic_workflows", "to": "fynd_platform", "data": "applyCoupon to cart", "mechanism": "Fynd SDK" },
        { "from": "boltic_workflows", "returns": "{ url: cart_page_url }" },
        { "from": "frontend_app", "action": "Redirect to cart page" }
      ]
    }
  ],

